# OctoFit Tracker - Frontend Environment Variables
#
# VITE_CODESPACE_NAME must be set when running in GitHub Codespaces.
# Copy this file to .env.local and fill in your values.
#
# In Codespaces, set this to your codespace name, e.g.:
#   VITE_CODESPACE_NAME=your-codespace-name
#
# When unset, the frontend falls back to http://localhost:8000
VITE_CODESPACE_NAME=
